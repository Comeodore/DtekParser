DATABASE_URL=postgresql://user:password@192.168.0.185:5432/database
# A separate schema gives a fully isolated instance (staging); public is production.
DB_SCHEMA=public

SOURCES=kem,krem

# Kyiv city
KEM_STREET=просп. Європейського Союзу
KEM_BUILDING=43
KEM_PORT=9999
KEM_SCHEDULE_ID=1
KEM_LANG=en
KEM_BOT=lightbot
KEM_CHAT_IDS=111111111,222222222
KEM_NOTIFY_OUTAGES=true

# Kyiv region
KREM_STREET=вул. Садова
KREM_BUILDING=10
KREM_SETTLEMENT=с. Круглик
KREM_PORT=9998
KREM_SCHEDULE_ID=2
KREM_LANG=uk
KREM_BOT=schedulebot
KREM_CHAT_IDS=111111111,333333333
KREM_NOTIFY_OUTAGES=false

BOT_LIGHTBOT_TOKEN=
BOT_SCHEDULEBOT_TOKEN=

# Home Assistant power monitor (omit HA_WS_URL to disable)
HA_WS_URL=wss://ha.example.com/api/websocket
HA_TOKEN=
POWER_SOURCE=kem
# HA_VOLTAGE_ENTITY=sensor.victron_vebus_activein_l1_voltage_228
# HA_BATTERY_ENTITY=sensor.victron_battery_soc
# Positive while charging; shown as "Home" in POWER_SOURCE's mini app
# HA_BATTERY_POWER_ENTITY=sensor.victron_system_battery_power
# POWER_MIN_VOLTAGE=50

# Deye Cloud inverter at the krem address (developer.deyecloud.com app; tools/deye_probe.py)
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
# sha256 of the Deye Cloud password: printf '%s' 'password' | shasum -a 256
DEYE_PASSWORD_SHA256=
DEYE_STATION_ID=
# Other Deye inverters read in the same call, as name:serial; their batteries show in
# DEYE_BATTERIES_SOURCE's mini app (names with an icon: elevator, water)
DEYE_BATTERIES=elevator:2407244424,water:2407244735
DEYE_BATTERIES_SOURCE=kem
# DEYE_BASE_URL=https://eu1-developer.deyecloud.com
# Message the krem chats when the inverter loses or regains the grid
# DEYE_NOTIFY_GRID=true
# Poll interval until the first reading; after that polls follow the logger's upload rhythm
# DEYE_INTERVAL=60
# deye-reserve (its own container): told when krem's schedule or grid changes
DEYE_RESERVE_URL=http://127.0.0.1:9997

# deye-reserve: plans the krem inverter's Time of Use table and messages the owner.
# Writing to the inverter stays off unless this is true.
DEYE_RESERVE_WRITE=false
# The owner's own chat (never the shared krem chats), through DEYE_RESERVE_BOT (default schedulebot)
DEYE_RESERVE_CHAT_ID=
# DEYE_RESERVE_GROUP=GPV2.2
# DEYE_RESERVE_DTEK_URL=http://127.0.0.1:9998
# DEYE_RESERVE_PORT=9997
# DEYE_RESERVE_DEVICE_SN=          # the station's first inverter when not set
# Battery and tariff (defaults: 10.24 kWh, 0.95 one way, 2.7 kW grid charge, 4.32 / 2.16 UAH, night 23-7)
# DEYE_RESERVE_CAPACITY_KWH=10.24
# DEYE_RESERVE_CHARGE_KW=2.7
# DEYE_RESERVE_DAY_PRICE=4.32
# DEYE_RESERVE_NIGHT_PRICE=2.16
# SOC limits: shutdown 20, pessimistic floor in outages 25, day floor 45, night 45-95
# DEYE_RESERVE_OUTAGE_MIN_SOC=25
# DEYE_RESERVE_DAY_FLOOR=45
# DEYE_RESERVE_NIGHT_MAX=95
# DEYE_RESERVE_MAX_WRITES=6
# The sun's median is of the models that matched the panels best over the last days
# DEYE_RESERVE_TOP_MODELS=3
# DEYE_RESERVE_RANK_DAYS=14
# DEYE_RESERVE_DRY_RUN=false       # log messages instead of sending them
# Solcast rooftop site, watched only (logged, compared with the panels in the review, not planned with)
# SOLCAST_API_KEY=
# SOLCAST_SITE_ID=
# DEYE_RESERVE_SOLCAST_AT=05:34,08:34,10:34,12:34,14:34,22:04
# DEYE_RESERVE_SOLCAST_MAX_CALLS=8   # per UTC day; the free tier allows 10

# Wake-on-LAN for HA's rest_command.wake_pc (omit to disable the endpoint)
WOL_MAC=
# WOL_BROADCAST=255.255.255.255

HEARTBEAT_URL=http://192.168.0.185:8099
# FETCH_INTERVAL=60
# Log messages instead of sending them
NOTIFY_DRY_RUN=false
