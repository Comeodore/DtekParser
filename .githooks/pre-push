#!/bin/sh
# DtekParser: push main only. Deleting a stray branch on the remote is allowed.
status=0
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    case "$remote_ref" in
        refs/heads/main | refs/tags/*) ;;
        *)
            echo "DtekParser: push main only (refused '$remote_ref'). Commit to main and push main." >&2
            status=1
            ;;
    esac
done
exit $status
