// dtek-edge (dtek-watch-test until 04.11.2026), deployed through the Cloudflare API (01.11.2026, as the reserve
// 02.11.2026);
// `npx wrangler deploy` from this folder gives the same Worker. Secrets, set once with
// `npx wrangler secret put <NAME>`: the addresses KEM_STREET KEM_BUILDING KREM_SETTLEMENT KREM_STREET
// KREM_BUILDING, EDGE_KEY, the key the home service sends (its EDGE_KEY in .env), its Deye Cloud credentials
// DEYE_APP_ID DEYE_APP_SECRET DEYE_EMAIL DEYE_PASSWORD_SHA256 (as in .env), and VRM_TOKEN, a VRM access token
// for kem's Victron (VRM → Preferences → Integrations → Access tokens; svitlo-edge's until 05.11.2026).
// dtek-brain (brain.py) is a Python Worker of its own, uploaded from what bundle.py packs; deploy it first.
{
  "name": "dtek-edge",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // The home service pushes to https://dtek-edge.maksymchuk-vladimir.workers.dev.
  "workers_dev": true,
  "observability": { "enabled": true },
  // live: takes a source over while the home service is away; test: runs the reserve always, to TEST_CHAT_ID only.
  // VRM_SITE_ID: kem's VRM installation.
  "vars": { "MODE": "live", "TEST_CHAT_ID": "", "VRM_SITE_ID": "514696" },
  // From D1 alone while the home service is alive: wakes a source's object once it must read DTEK, and watches the
  // power (VRM, Deye) while the home service is away.
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "WATCHER", "class_name": "Watcher" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Watcher"] }],
  "services": [{ "binding": "BRAIN", "service": "dtek-brain" }],
  // The mini apps' pages, `/` alone (their data goes straight to the home service): passed on to the home service,
  // stood in for while it does not answer (worker.js standIn). Both fail open (request_limit_fail_open, set in the
  // dashboard or the API): past the daily Workers limit they go straight to the tunnel.
  "routes": [
    { "pattern": "dtek-schedule.comeodore.services/", "zone_name": "comeodore.services" },
    { "pattern": "dtek-krem-schedule.comeodore.services/", "zone_name": "comeodore.services" }
  ],
  // The page itself, app/static/index.html, as a Text module (uploaded as edge/worker.js + app/static/index.html).
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtek-edge",
      "database_id": "b9ec3211-81ab-4251-b9cd-bceb03fefe13"
    }
  ]
}
